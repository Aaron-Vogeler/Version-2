# AI Server Environment Variables
# Copy this file to .env and fill in the actual values

# ============================================
# Server Configuration
# ============================================
# HTTP/WebSocket server port (optional, defaults to 8080)
PORT=8080

# ============================================
# Speech-to-Text (Deepgram)
# ============================================
# Deepgram API key for speech-to-text transcription
# Get your key at: https://console.deepgram.com
DEEPGRAM_API_KEY=

# ============================================
# Large Language Model (Groq)
# ============================================
# Groq API key for fast LLM inference
# Get your key at: https://console.groq.com
GROQ_API_KEY=

# ============================================
# Database (Supabase)
# ============================================
# Supabase project URL (e.g., https://project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service role key for admin database operations (keep private)
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# VoIP & Telephony (Telnyx)
# ============================================
# Telnyx API key for call routing and VoIP operations
# Get your key at: https://portal.telnyx.com
TELNYX_API_KEY=

# Telnyx webhook signing secret for validating incoming webhooks
TELNYX_SIGNING_SECRET=

# Telnyx SIP connection ID for routing calls
TELNYX_SIP_CONNECTION_ID=

# Phone number to monitor for incoming calls (e.g., +1234567890)
NEXT_PUBLIC_MONITOR_NUMBER=

# ============================================
# Application Configuration
# ============================================
# Application base URL (e.g., https://version-2-cr4fsa.fly.dev)
# Used for webhook callbacks and redirects
NEXT_PUBLIC_APP_URL=
