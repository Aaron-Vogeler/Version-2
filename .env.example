# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Configuration (for workers)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Telnyx Configuration
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_SIGNING_SECRET=your-webhook-signing-secret
TELNYX_SIP_CONNECTION_ID=your-sip-connection-id
NEXT_PUBLIC_MONITOR_NUMBER=+1234567890

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth Configuration (Email/Password Authentication)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-min-32-chars

# Worker Authentication (optional)
# WORKER_TOKEN=your-optional-worker-bearer-token
